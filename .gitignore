# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data. Since Tier 5 the rule is one line long: IMAGES are ignored, everything
# that DESCRIBES them is committed. A corpus's index.csv and corpus.yaml, and
# every manifest recipe and its resolved CSV, are the contract this project is
# reproducible against -- they are a few MB and they belong in review.
data/corpora/*/images/**
# A pull's resume state is per-machine and MUST NOT travel with the repo: a
# fresh clone that had this file would believe `rows_written` rows are already
# on disk and resume past them, producing a corpus with holes and a state file
# claiming it is complete -- the exact failure fetchers/base.py orders its
# writes to prevent. The index.csv and corpus.yaml beside it ARE committed;
# they describe the corpus, not one machine's progress through it.
data/corpora/*/.pull_state.json

# The one exception: data/quarantine holds a REJECTED corpus reduced to a
# six-image evidence strip and the write-up explaining why. Half a megabyte,
# and the lesson is the artifact -- an evidence directory that is gitignored is
# evidence nobody will ever see again.

# Rebuildable from the images: the embedding projections and the
# content-addressed store (the default $AIGC_CACHE_ROOT, so it lands inside the
# repo unless pointed elsewhere).
data/embeddings/**
data/cache/**
*.png
!docs/**/*.png
checkpoints/
models/
outputs/
runs/
wandb/

# Credentials
.env
kaggle.json

# OS
.DS_Store
Thumbs.db

# Local Claude Code session state
.claude/

# OOD evaluation tier (downloaded, evaluation only)
data/ood/**
!data/ood/.gitkeep

# Error analysis outputs (deliverable 5.5.5) - regenerable
reports/error_analysis/**
!reports/error_analysis/*.md
!reports/error_analysis/*.csv

# Extended training slice (downloaded)
data/train_ext/**

# Manifests ARE committed - they are the contract that defines every cache
# fingerprint. Secondary machines must get them byte-identical, never rebuild
# them with `split` (see scripts/worker.py). Images stay ignored.
!data/processed/*.csv
!data/ood/ood.csv
!data/heldout/heldout.csv
!data/demo_val/demo_val.csv
!data/train_ext/*.csv
!data/raw/tiny_genimage_index.csv

# Voice memos / scratch audio (kept locally, never committed)
*.mp3

# Refactor baseline captures (regenerable, local only)
.refactor_baseline/
