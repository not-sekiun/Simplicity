# Copy to .env and fill in what you need. .env is gitignored and is never read
# by anything but aigc_detect.config.settings. Every value here has a working
# default, so an empty .env is a valid configuration -- these exist to let you
# move the data off your system drive, point at a gated dataset, or run the
# demo server against a different checkpoint without editing code.

# --- Credentials -------------------------------------------------------------
# Needed only for GATED HuggingFace repos. Every corpus this project currently
# pulls is ungated, so this is usually blank. huggingface_hub also reads
# HF_TOKEN on its own; setting it here keeps the project's own credentials in
# one file rather than split between a shell profile and a CLI login.
HF_TOKEN=

# Needed for the Kaggle-hosted COCO val2017 mirror. The official S3 bucket was
# measured at ~12 kB/s on this network (18+ hour ETA) against Kaggle's ~20 MB/s,
# which is why the Kaggle path is preferred. Get these from your Kaggle account
# page -> "Create New Token".
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Where things live -------------------------------------------------------
# The image corpora and the embedding cache are the two large directories
# (roughly 24 GB and 5 GB). Point them at another drive to keep them off the
# system disk. Relative paths resolve against the repo root; absolute paths are
# used as given. Defaults: <repo>/data and <repo>/data/cache.
AIGC_DATA_ROOT=
AIGC_CACHE_ROOT=

# --- Runtime -----------------------------------------------------------------
# "cuda", "cpu", or blank to auto-detect (cuda when available, else cpu).
AIGC_DEVICE=

# The checkpoint predict.py and the demo server load by default. Blank uses the
# shipping head. Set this to evaluate a different arm without passing --head to
# every command.
AIGC_MODEL_BUNDLE=

# --- Demo server -------------------------------------------------------------
# The browser extension talks to this address. If you change the port here,
# change it in the extension's options page too -- the extension stores its own
# copy, since it cannot read this file.
AIGC_SERVER_HOST=127.0.0.1
AIGC_SERVER_PORT=8765
